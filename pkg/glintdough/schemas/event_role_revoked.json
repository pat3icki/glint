{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glintdough/event/role_revoked",
  "title": "RoleRevoked event data",
  "type": "object",
  "required": ["role", "account", "sender"],
  "additionalProperties": false,
  "properties": {
    "role":    { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "account": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "sender":  { "type": "string", "pattern": "^0x[0-9a-f]{40}$" }
  }
}

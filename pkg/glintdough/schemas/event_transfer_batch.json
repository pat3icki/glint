{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glintdough/event/transfer_batch",
  "title": "TransferBatch event data",
  "type": "object",
  "required": ["ids", "values"],
  "additionalProperties": false,
  "properties": {
    "operator": { "type": "string", "pattern": "^0x[0-9a-f]{40}$", "description": "Operator address (indexed)" },
    "from":     { "type": "string", "pattern": "^0x[0-9a-f]{40}$", "description": "Sender address (indexed); 0x000...000 for mint" },
    "to":       { "type": "string", "pattern": "^0x[0-9a-f]{40}$", "description": "Recipient address (indexed); 0x000...000 for burn" },
    "ids":      { "type": "array", "items": { "type": "string" }, "description": "ERC-1155 token IDs (uint256[] as decimal strings)" },
    "values":   { "type": "array", "items": { "type": "string" }, "description": "Amounts transferred (uint256[] as decimal strings)" }
  }
}
